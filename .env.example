# Servidor HTTP
PORT=3000
# Dominios/hosts permitidos separados por coma (o * para cualquier host en desarrollo)
ALLOWED_HOSTS=localhost,127.0.0.1

# Seguridad (similar a SECRET_KEY en Django)
# Usado para firmar cookies de sesión (HMAC) y tokens internos
SECRET_TOKEN=cambiar_por_un_secreto_largo_aleatorio
# Clave maestra para administrar y cambiar instancias de base de datos
DB_MASTER_KEY=cambiar_por_clave_maestra_segura
# Nombre de la base de datos por defecto en ./db/<nombre>.sqlite
DEFAULT_DB=database

# Cookies seguras (poner true si corre detrás de HTTPS)
COOKIE_SECURE=false

# Logger
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs/

# Integraciones externas opcionales (futuros servicios)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# AFIP_CUIT=
# AFIP_CERT_PATH=
# MERCADOPAGO_ACCESS_TOKEN=
# WEBHOOK_SECRET=
